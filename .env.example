# Postgres (server-side only)
POSTGRES_USER=freshcase
POSTGRES_PASSWORD=freshcase
POSTGRES_DB=freshcase
DATABASE_URL=postgresql://freshcase:freshcase@db:5432/freshcase

# External API keys (server-side only — never expose to the browser)
